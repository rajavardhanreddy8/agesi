# Backend Environment Variables (form_filler/)

# Database (Railway provides these via MySQL addon)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your-password

# Security Keys
FLASK_SECRET_KEY=your-super-secret-flask-key
ENCRYPTION_KEY=your-fernet-encryption-key

# SMTP for Email Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_live_SDcqknc6G4xFYv
RAZORPAY_KEY_SECRET=M5tSvmjcBxw4EJb7UzwdWGF5

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$...

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.up.railway.app

# Railway flags
RAILWAY_ENVIRONMENT=production
FLASK_DEBUG=false
PORT=5000
