# Razorpay Payment Gateway Configuration
# Copy this to your .env file and fill in your credentials

# ============================================================================
# RAZORPAY TEST CREDENTIALS (for local development)
# ============================================================================
# Get your test keys from: https://dashboard.razorpay.com/app/keys
# Test keys start with: rzp_test_

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Optional: Webhook secret (if you implement webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ============================================================================
# RAZORPAY LIVE CREDENTIALS (for production - Azure only!)
# ============================================================================
# ⚠️ NEVER commit live credentials to version control!
# ⚠️ Set these directly in Azure App Service configuration
# 
# Get your live keys from: https://dashboard.razorpay.com/app/keys
# Live keys start with: rzp_live_
# 
# Set in Azure:
# az webapp config appsettings set --name outing-backend-api \
#   --resource-group rg-outing-agent \
#   --settings RAZORPAY_KEY_ID="rzp_live_xxx" \
#              RAZORPAY_KEY_SECRET="your_live_secret"

# ============================================================================
# EXISTING CONFIGURATION (keep your current values)
# ============================================================================

# Admin credentials
ADMIN_EMAIL=campusouting.go@gmail.com
ADMIN_PASSWORD=rama:123

# Database (Supabase)
DATABASE_URL=your_database_url_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Encryption key for Outlook passwords
ENCRYPTION_KEY=your_encryption_key_here

# Flask settings
FLASK_DEBUG=true
PORT=5000
